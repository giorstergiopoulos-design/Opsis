    { "key": "sensitivity", "type": "slider",   "label": "Audio sensitivity", "labelEl": "Ευαισθησία ήχου", "min": 1, "max": 10, "step": 1, "default": 5 },
    { "key": "style",       "type": "combo",    "label": "Spectrum style",  "labelEl": "Στυλ φάσματος", "options": ["Bars", "Line"], "default": "Bars" },
    { "key": "title",       "type": "text",     "label": "Title",           "labelEl": "Τίτλος", "default": "OPSIS" }
  ]
