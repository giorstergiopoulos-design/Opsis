{
  "name": "System monitor (sample)",
  "author": "Opsis",
  "description": "Live CPU, memory, network and audio spectrum drawn on the desktop. Shows how a web wallpaper receives system data and its own settings from Opsis.",
  "properties": [
    { "key": "accent",      "type": "color",    "label": "Accent colour",   "labelEl": "Χρώμα έμφασης", "default": "#00c8e6" },
