<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <!-- RootNamespace ΣΚΟΠΙΜΑ παραμένει "MotionDesk" στη μετονομασία σε "Opsis": καθαρά εσωτερικό
         C# identifier, αόρατο στον χρήστη — το να το μετονομάσεις θα σήμαινε edit σε ~70+ αρχεία
         (κάθε namespace/using) για μηδενικό ορατό όφελος. Το AssemblyName (-> exe filename) ΑΛΛΑΖΕΙ
         γιατί αυτό ΕΙΝΑΙ ορατό (Task Manager, Program Files, συντομεύσεις). -->
    <RootNamespace>MotionDesk</RootNamespace>
    <AssemblyName>Opsis</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\Opsis.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 10 WinForms SDK: WFO1000 ζητάει [DesignerSerializationVisibility] σε κάθε public
         property custom Control για τον Designer serializer. Αυτό το project ΔΕΝ χρησιμοποιεί ΠΟΤΕ
         τον WinForms Visual Designer (όλα τα controls χτίζονται με κώδικα) — το attribute δεν θα
         είχε κανένα πρακτικό αποτέλεσμα, μόνο θα πρόσθετε ~35+ άσχετα attributes σε custom controls.
         Βλ. https://aka.ms/winforms-warnings/wfo1000 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <Version>2.1.2</Version>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
    <Product>Opsis - Desktop Customization</Product>
    <!-- Ζητήθηκε ρητά "η εφαρμογή να μην περνά ως false positive". Πραγματική, εγγυημένη λύση
         είναι μόνο ένα πληρωμένο code-signing certificate (βλ. PROJECT_STATE.md — παραλείφθηκε
         αυτόν τον γύρο, δεν υπάρχει certificate διαθέσιμο). Χωρίς αυτό, τα παρακάτω είναι η
         καλύτερη δυνατή "υγιεινή" έκδοσης: πλήρη, ρεαλιστικά PE version metadata (οι
         false-positive heuristics πολλών AV βαθμολογούν αρνητικά exe χωρίς Company/Copyright/
         Description) — το project ήδη ΔΕΝ κάνει trimming/single-file/ReadyToRun/obfuscation
         (άλλος συνηθισμένος λόγος false positive), οπότε δεν χρειάζεται αλλαγή εκεί.
    -->
    <Company>Opsis Team</Company>
    <Authors>Opsis Team</Authors>
    <Copyright>Copyright © 2026 Opsis Team</Copyright>
    <Description>Opsis - Desktop Customization — animated desktop wallpaper and workspace customization for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Επιτρέπει στο tests/Opsis.Tests να βλέπει internal classes όπως το AtomicFile χωρίς να τα κάνει public. -->
    <InternalsVisibleTo Include="Opsis.Tests" />
  </ItemGroup>

  <!-- Single native UI stack: WinForms. WPF was removed to reduce framework overhead and complexity. -->
  <ItemGroup>
    <Compile Remove="src\Core\**" />
    <!-- tests\Opsis.Tests: δικό του ξεχωριστό project — χωρίς αυτό, το SDK-style implicit glob θα
         το μάζευε ΚΑΙ εδώ (το tests\ είναι κάτω από τη ρίζα του repo, όπως και το src\), προσπαθώντας
         να μεταγλωττίσει κώδικα xunit μέσα στο ίδιο το Opsis.exe. -->
    <Compile Remove="tests\**" />
  </ItemGroup>

  <!-- Plugin contract (Opsis - Desktop Customization plugin mechanism). Plugins live in "plugins\<name>\" folders
       and implement IOpsisNewsCrawlerPlugin; see src\Services\PluginHost.cs. -->
  <ItemGroup>
    <Reference Include="OpsisNewsCrawler.Plugin.Abstractions">
      <HintPath>libs\OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Μόνο για τη νέα Quick Settings κάρτα (φωτεινότητα οθόνης μέσω WMI WmiMonitorBrightnessMethods). -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!-- WinForms-only WebView2 reference: do not import the package's WPF build assets. -->
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="src\Widgets\sysmon\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>widgets\sysmon\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="src\Widgets\wallpaper\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>widgets\wallpaper\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="locales\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>locales\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="assets\Opsis.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\Opsis.ico</Link>
    </None>
    <None Include="assets\tray\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\tray\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE</Link>
    </None>
  </ItemGroup>


  <!-- WebView2 is used through WinForms only. Prevent the package's WPF assembly from entering RAR. -->
  <ItemGroup>
    <Reference Remove="Microsoft.Web.WebView2.Wpf" />
    <Reference Remove="WindowsBase" />
    <Reference Remove="PresentationCore" />
    <Reference Remove="PresentationFramework" />
  </ItemGroup>


  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>

